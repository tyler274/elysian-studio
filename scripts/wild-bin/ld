#!/usr/bin/env bash
# GCC -B helper: this directory is passed as -B so `cc` execs Wild as `ld`.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"

if command -v wild >/dev/null 2>&1; then
  exec wild "$@"
fi

for candidate in \
  "${WILD:-}" \
  "$root/../wild/target/release/wild" \
  "$root/../wild/target/debug/wild"; do
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    exec "$candidate" "$@"
  fi
done

echo "wild linker not found; build ../wild or enter nix develop" >&2
exit 1
